":null,"reactions":{"url":"https://api.github.com/repos/otpanda/extension/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/otpanda/extension/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/otpanda/extension/issues/2","repository_url":"https://api.github.com/repos/otpanda/extension","labels_url":"https://api.github.com/repos/otpanda/extension/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/otpanda/extension/issues/2/comments","events_url":"https://api.github.com/repos/otpanda/extension/issues/2/events","html_url":"https://github.com/otpanda/extension/pull/2","id":6557306138,"node_id":"PR_kwDOV39I4M8AAAABRO16NA","number":2,"title":"Align extension transport with entry-scoped API and millisecond expiry","user":{"login":"abrahammurciano","id":25041135,"node_id":"MDQ6VXNlcjI1MDQxMTM1","avatar_url":"https://avatars.githubusercontent.com/u/25041135?v=4","gravatar_id":"","url":"https://api.github.com/users/abrahammurciano","html_url":"https://github.com/abrahammurciano","followers_url":"https://api.github.com/users/abrahammurciano/followers","following_url":"https://api.github.com/users/abrahammurciano/following{/other_user}","gists_url":"https://api.github.com/users/abrahammurciano/gists{/gist_id}","starred_url":"https://api.github.com/users/abrahammurciano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abrahammurciano/subscriptions","organizations_url":"https://api.github.com/users/abrahammurciano/orgs","repos_url":"https://api.github.com/users/abrahammurciano/repos","events_url":"https://api.github.com/users/abrahammurciano/events{/privacy}","received_events_url":"https://api.github.com/users/abrahammurciano/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assig