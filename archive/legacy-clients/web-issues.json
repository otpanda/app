d removes expired codes. Assignment remains explicitly unavailable.\n\nEight unit tests and browser regression pass, including home/Unassigned visibility, narrow layout, expiry and existing code/search behavior. No catalog, TOTP, analytics or deployment changes.","closed_by":{"login":"abrahammurciano","id":25041135,"node_id":"MDQ6VXNlcjI1MDQxMTM1","avatar_url":"https://avatars.githubusercontent.com/u/25041135?v=4","gravatar_id":"","url":"https://api.github.com/users/abrahammurciano","html_url":"https://github.com/abrahammurciano","followers_url":"https://api.github.com/users/abrahammurciano/followers","following_url":"https://api.github.com/users/abrahammurciano/following{/other_user}","gists_url":"https://api.github.com/users/abrahammurciano/gists{/gist_id}","starred_url":"https://api.github.com/users/abrahammurciano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abrahammurciano/subscriptions","organizations_url":"https://api.github.com/users/abrahammurciano/orgs","repos_url":"https://api.github.com/users/abrahammurciano/repos","events_url":"https://api.github.com/users/abrahammurciano/events{/privacy}","received_events_url":"https://api.github.com/users/abrahammurciano/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/otpanda/web/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/otpanda/web/issues/2/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/otpanda/web/issues/1","repository_url":"https://api.github.com/repos/otpanda/web","labels_url":"https://api.github.com/repos/otpanda/web/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/otpanda/web/issues/1/comments","events_url":"https://api.github.com/repos/otpanda/web/issues/1/events","html_url":"https://github.com/otpanda/web/pull/1","id"