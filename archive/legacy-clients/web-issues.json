m/users/abrahammurciano/followers","following_url":"https://api.github.com/users/abrahammurciano/following{/other_user}","gists_url":"https://api.github.com/users/abrahammurciano/gists{/gist_id}","starred_url":"https://api.github.com/users/abrahammurciano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abrahammurciano/subscriptions","organizations_url":"https://api.github.com/users/abrahammurciano/orgs","repos_url":"https://api.github.com/users/abrahammurciano/repos","events_url":"https://api.github.com/users/abrahammurciano/events{/privacy}","received_events_url":"https://api.github.com/users/abrahammurciano/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-11-23T10:36:47Z","updated_at":"2026-11-23T10:38:26Z","closed_at":"2026-11-23T10:38:25Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/otpanda/web/pulls/6","html_url":"https://github.com/otpanda/web/pull/6","diff_url":"https://github.com/otpanda/web/pull/6.diff","patch_url":"https://github.com/otpanda/web/pull/6.patch","merged_at":"2026-11-23T10:38:25Z"},"body":"Add a bounded Access dialog for creating entry-scoped automation tokens through the existing CSRF-protected API. Neither entry nor duration is preselected. The client label and duration are explicit, the warning explains unattended code-read access, and only owned entries with server manage capability are offered. Shared-recipient token setup remains unavailable in this client.\n\nNew token is shown only in a memory-only dialog, cleared on close, navigation or backgrounding. Closing does not revoke it. Uncertain creation failures disable retry and direct the user to refresh Access and revoke unintended tokens. Existing token revocation remains available.\n\nValidation: 11 unit tests, synthetic browser regression at 320/390px including selection, reveal/clearing and uncertain-response behavior, plus real local HTTPS API/session/CSRF/SQLite integration creating, listing and revoking a synthetic token. No production connection, deployment or real secrets.","closed_by":{"login":"abrahammurciano","id":25041135,"node_id":"MDQ6VXNlcjI1MDQxMTM1","avatar_url":"https://avatars.githubusercontent.com/u/25041135?v=4","gravatar_id":"","url":"https://api.github.com/users/abrahammurciano","html_url":"https://github.com/abrahammurciano","followers_url":"https://api.github.com/users/abrahammurciano/followers","following_url":"https://api.github.com/users/abrahammurciano/following{/other_user}","gists_url":"https://api.github.com/users/abrahammurciano/gists{/gist_id}","starred_url":"https://api.github.com/users/abrahammurciano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abrahammurciano/subscriptions","organizations_url":"https://api.github.com/users/abrahammurciano/orgs","repos_url":"https://api.github.com/users/abrahammurciano/repos","events_url":"https://api.github.com/users/abrahammurciano/events{/privacy}","received_events_url":"https://api.github.com/users/abrahammurciano/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/otpanda/web/issues/6/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/otpanda/web/issues/6/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/otpanda/web/issues/5","repository_url":"https://api.github.com/repos/otpanda/web","labels_url":"https://api.github.com/repos/otpanda/web/issues/5/labels{/name}","comments_url":"https://api.github.com/repos/otpanda/web/issues/5/comments","events_url":"https://api.github.com/repos/otpanda/web/issues/5/events","html_url":"https://github.com/